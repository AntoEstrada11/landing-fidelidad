# Copia este archivo a `.env` y completa los valores.

# --- Catálogo de iglesias ---
# json = lee server/data/iglesias-bloques.json (recomendado)
# odoo = consulta Odoo y agrupa en un solo bloque
IGLESIAS_SOURCE=json

# --- Odoo (solo si IGLESIAS_SOURCE=odoo) ---
# URL base de tu instancia, sin barra final
ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=tu_base_de_datos
ODOO_USERNAME=api_landing@ejemplo.com
# Contraseña del usuario o API key (Odoo 14+)
ODOO_PASSWORD=

# Modelo y filtros (ajusta según tu implementación en Odoo)
ODOO_CHURCH_MODEL=res.partner
# Dominio JSON de search_read, ej: [["is_company","=",true],["active","=",true]]
ODOO_CHURCH_DOMAIN=[]
# Campo a mostrar en el select (name, display_name, etc.)
ODOO_CHURCH_NAME_FIELD=name
ODOO_CHURCH_LIMIT=500

# Agrega la opción "Otras" al final del listado (id=0)
ODOO_APPEND_OTRAS=true

# true = siempre usa lista fija local (sin llamar a Odoo)
ODOO_USE_FALLBACK=false

# false = si Odoo falla, responde HTTP 502. true (default) = devuelve listado local
ODOO_FALLBACK_ON_ERROR=true
