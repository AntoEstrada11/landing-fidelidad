# Copia este archivo a `.env` y completa los valores.

# --- Catálogo de iglesias ---
# json = server/data/iglesias-bloques.json
# odoo = consulta Odoo
# api  = SELECTOR-IGLESIAS-API
IGLESIAS_SOURCE=json

IGLESIAS_API_URL=http://localhost:3000/api/elementos
IGLESIAS_API_KEY=
IGLESIAS_API_TIMEOUT_MS=15000
IGLESIAS_API_FALLBACK_ON_ERROR=true

NUXT_PUBLIC_LOCALIZADOR_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pasarela de pago (Mercado Pago Checkout Pro) ---
# Credenciales en: https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
# true = usa sandbox_init_point (pruebas). false = producción.
MERCADOPAGO_SANDBOX=true

# --- Analítica (clics, navegación, errores) ---
# Clave para consultar GET /api/analytics/events y /api/analytics/summary
ANALYTICS_API_KEY=

# --- Odoo (solo si IGLESIAS_SOURCE=odoo) ---
ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=tu_base_de_datos
ODOO_USERNAME=api_landing@ejemplo.com
ODOO_PASSWORD=
ODOO_CHURCH_MODEL=res.partner
ODOO_CHURCH_DOMAIN=[]
ODOO_CHURCH_NAME_FIELD=name
ODOO_CHURCH_LIMIT=500
ODOO_APPEND_OTRAS=true
ODOO_USE_FALLBACK=false
ODOO_FALLBACK_ON_ERROR=true
